rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // FUNCIÓN HELPER para comprobar si un usuario es administrador ('jefe')
    function isJefe(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.userType == 'jefe';
    }

    // ===============================================
    // REGLAS PARA USUARIOS (`users`)
    // ===============================================
    match /users/{userId} {
      // Un perfil público lo puede leer cualquiera, O si es un jefe.
      allow read: if true; 
      // Para la página de desarrollador, un jefe puede leer todos los perfiles.
      allow list: if request.auth != null && isJefe(request.auth.uid);
      
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;

      match /following/{followId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }
      
      match /followers/{followerId} {
        allow read, list: if request.auth != null && request.auth.uid == userId;
        allow write: if false; 
      }
    }

    // ===============================================
    // REGLAS PARA LISTAS (`lists`)
    // ===============================================
    match /lists/{listId} {
      // Se puede leer si es pública, si eres el dueño, O si eres un jefe.
      allow read: if resource.data.isPublic == true || 
                     (request.auth != null && resource.data.userId == request.auth.uid) ||
                     (request.auth != null && isJefe(request.auth.uid));
      // Un jefe puede listar todas las listas.
      allow list: if request.auth != null && isJefe(request.auth.uid);

      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Las reglas de subcolecciones heredan la capacidad de lectura de un 'jefe' a través del `get()`
      match /reviews/{reviewId} {
         allow read: if get(/databases/$(database)/documents/lists/$(listId)).data.isPublic == true ||
                       (request.auth != null && get(/databases/$(database)/documents/lists/$(listId)).data.userId == request.auth.uid) ||
                       (request.auth != null && isJefe(request.auth.uid));
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      }
      
      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/lists/$(listId)).data.isPublic == true ||
                      (request.auth != null && get(/databases/$(database)/documents/lists/$(listId)).data.userId == request.auth.uid) ||
                      (request.auth != null && isJefe(request.auth.uid));
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/lists/$(listId)).data.userId == request.auth.uid);
      }
    }

    // ===============================================
    // REGLAS PARA LUGARES (`places`)
    // ===============================================
    match /places/{placeId} {
        allow read: if true;
        // Un jefe puede listar todos los lugares.
        allow list: if request.auth != null && isJefe(request.auth.uid);
        allow create: if request.auth != null;
        allow update, delete: if false;
    }
    
    // El resto de colecciones pueden ser listadas por un jefe.
    match /badges/{badgeId} {
      allow read: if true;
      allow list: if request.auth != null && isJefe(request.auth.uid);
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow list: if request.auth != null && isJefe(request.auth.uid);
      allow write: if false;
    }
  }
}