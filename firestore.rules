rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pachote entra con usuarios anónimos en este mismo proyecto: para Listopic no cuentan como sesión.
    function isUser() {
      return request.auth != null && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }

    // --- Función de ayuda para roles (UNIFICADA) ---
    function isJefe(userId) {
      return isUser() &&
             request.auth.uid == userId &&
             request.auth.token.admin == true;
    }

    function doesNotSetUserType() {
      return !request.resource.data.keys().hasAny(['userType']);
    }

    function doesNotChangeUserType() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userType']);
    }

    function userAllowedCreateKeys() {
      return [
        'username', 'usernameLower', 'displayName', 'name', 'surnames',
        'location', 'residence', 'bio', 'email', 'emailLowerCase',
        'photoUrl', 'photoURL', 'photoStoragePath', 'defaultDistanceKm',
        'mapLayerPreference', 'themePreference', 'notificationPreferences',
        'isOnline', 'lastActiveAt', 'createdAt', 'updatedAt', 'usernameLockedAt',
        'legalAcceptance'
      ];
    }

    function userAllowedUpdateKeys() {
      return [
        'username', 'usernameLower', 'displayName', 'name', 'surnames',
        'location', 'residence', 'bio', 'email', 'emailLowerCase',
        'photoUrl', 'photoURL', 'photoStoragePath', 'defaultDistanceKm',
        'mapLayerPreference', 'themePreference', 'notificationPreferences',
        'isOnline', 'lastActiveAt', 'createdAt', 'updatedAt', 'usernameLockedAt',
        'userType', 'badges', 'listsCount', 'listCount', 'reviewsCount',
        'reviewCount', 'followersCount', 'followingCount', 'followingUsersCount',
        'followingListsCount', 'followingPlacesCount', 'level', 'xp',
        'notifiedLevel', 'notifiedBadges', 'lastStatsRecalc', 'averageRating'
      ];
    }

    // Lo que un usuario puede cambiar de sí mismo: perfil, preferencias,
    // presencia y el registro de qué nivel/insignias ya se le notificaron.
    // Insignias, XP, nivel, contadores y rol solo los escriben Cloud Functions
    // (o un jefe).
    function userSelfUpdateKeys() {
      return [
        'username', 'usernameLower', 'displayName', 'name', 'surnames',
        'location', 'residence', 'bio', 'email', 'emailLowerCase',
        'photoUrl', 'photoURL', 'photoStoragePath', 'defaultDistanceKm',
        'mapLayerPreference', 'themePreference', 'notificationPreferences',
        'isOnline', 'lastActiveAt', 'createdAt', 'updatedAt', 'usernameLockedAt',
        'notifiedLevel', 'notifiedBadges', 'legalAcceptance', 'uxPreferences'
      ];
    }

    // Preferencias de uso (Mis preferencias y ayudas): interruptores y la lista de alérgenos.
    function uxPreferencesIsValid(value) {
      return value is map &&
             value.keys().hasOnly(['glutenFree', 'lactoseFree', 'vegetarian', 'vegan', 'allergens', 'stepFree', 'accessibleRestroom', 'petFriendly', 'contribute', 'showHelpTips']) &&
             (!('lactoseFree' in value) || value.lactoseFree is bool) &&
             (!('contribute' in value) || (value.contribute is list && value.contribute.size() <= 7)) &&
             (!('glutenFree' in value) || value.glutenFree is bool) &&
             (!('vegetarian' in value) || value.vegetarian is bool) &&
             (!('vegan' in value) || value.vegan is bool) &&
             (!('allergens' in value) || (value.allergens is list && value.allergens.size() <= 14)) &&
             (!('stepFree' in value) || value.stepFree is bool) &&
             (!('accessibleRestroom' in value) || value.accessibleRestroom is bool) &&
             (!('petFriendly' in value) || value.petFriendly is bool) &&
             (!('showHelpTips' in value) || value.showHelpTips is bool);
    }

    function aptAnswerOk(answers, key) {
      return !(key in answers) || answers[key] in ['yes', 'no'];
    }

    function aptReportIsValid(data, uid, reviewId) {
      return data.keys().hasOnly(['listId', 'answers', 'updatedAt']) &&
             data.listId is string && data.listId.size() > 0 && data.listId.size() <= 200 &&
             data.updatedAt == request.time &&
             data.answers is map &&
             data.answers.keys().hasOnly(['glutenFree', 'lactoseFree', 'vegetarian', 'vegan', 'stepFree', 'accessibleRestroom', 'petFriendly']) &&
             aptAnswerOk(data.answers, 'glutenFree') && aptAnswerOk(data.answers, 'lactoseFree') &&
             aptAnswerOk(data.answers, 'vegetarian') && aptAnswerOk(data.answers, 'vegan') &&
             aptAnswerOk(data.answers, 'stepFree') && aptAnswerOk(data.answers, 'accessibleRestroom') &&
             aptAnswerOk(data.answers, 'petFriendly') &&
             get(/databases/$(database)/documents/lists/$(data.listId)/reviews/$(reviewId)).data.userId == uid;
    }

    function userUpdateUxPreferencesOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uxPreferences']) ||
             uxPreferencesIsValid(request.resource.data.uxPreferences);
    }

    // Aceptación de Términos y Privacidad (prueba RGPD): solo la versión, la
    // confirmación de edad y el método; la fecha la pone el servidor.
    function legalAcceptanceIsValid(value) {
      return value is map &&
             value.keys().hasOnly(['version', 'acceptedAt', 'ageConfirmed', 'method']) &&
             value.keys().hasAll(['version', 'acceptedAt', 'ageConfirmed', 'method']) &&
             value.version is string && value.version.size() > 0 && value.version.size() <= 20 &&
             value.acceptedAt == request.time &&
             value.ageConfirmed == true &&
             value.method in ['signup', 'prompt'];
    }

    function userCreateLegalAcceptanceOk() {
      return !('legalAcceptance' in request.resource.data) ||
             legalAcceptanceIsValid(request.resource.data.legalAcceptance);
    }

    function userUpdateLegalAcceptanceOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['legalAcceptance']) ||
             legalAcceptanceIsValid(request.resource.data.legalAcceptance);
    }

    function userCreateHasOnlyAllowedFields() {
      return request.resource.data.keys().hasOnly(userAllowedCreateKeys());
    }

    function userUpdateChangesOnlyAllowedFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(userAllowedUpdateKeys());
    }

    function listAllowedCreateKeys() {
      return [
        'name', 'description', 'categoryId', 'userId', 'authorId',
        'authorName', 'authorUsername', 'authorPhoto', 'authorPhotoUrl',
        'isPublic', 'visibility', 'publicAccess', 'parentListId', 'parentId',
        'isSublist', 'editors', 'guests', 'mainImageUrl', 'photoUrl',
        'criteriaDefinition', 'availableTags', 'fixedTags', 'createdAt',
        'updatedAt', 'itemCount', 'groupedItemsCount', 'viewCount', 'likes',
        'followersCount', 'commentsCount', 'reviewCount', 'averageRating',
        'criteriaAverages', 'criteriaAveragesUpdatedAt', 'reactions',
        'lastActivityAt', 'lastReviewAt', 'scoringWeights', 'defaultDiet'
      ];
    }

    function listAllowedUpdateKeys() {
      return [
        'name', 'description', 'categoryId', 'userId', 'authorId',
        'authorName', 'authorUsername', 'authorPhoto', 'authorPhotoUrl',
        'isPublic', 'visibility', 'publicAccess', 'parentListId', 'parentId',
        'isSublist', 'editors', 'guests', 'mainImageUrl', 'photoUrl',
        'criteriaDefinition', 'availableTags', 'fixedTags', 'createdAt',
        'updatedAt', 'itemCount', 'groupedItemsCount', 'viewCount', 'likes',
        'followersCount', 'commentsCount', 'reviewCount', 'averageRating',
        'criteriaAverages', 'criteriaAveragesUpdatedAt', 'reactions',
        'lastActivityAt', 'lastReviewAt', 'ownerId', 'mainImagePath', 'slug',
        'deletedAt', 'scoringWeights', 'defaultDiet'
      ];
    }

    // «Dieta por defecto» de una lista: 'vegetarian' (todo vegetariano salvo lo marcado) o 'none'.
    function listDefaultDietOk() {
      return !('defaultDiet' in request.resource.data) || request.resource.data.defaultDiet in ['vegetarian', 'none'];
    }

    function listCreateHasOnlyAllowedFields() {
      return request.resource.data.keys().hasOnly(listAllowedCreateKeys()) && listDefaultDietOk();
    }

    function listUpdateChangesOnlyAllowedFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(listAllowedUpdateKeys()) && listDefaultDietOk();
    }

    // Métricas de una lista: las mantienen Cloud Functions a partir de las
    // reseñas. Un cliente (salvo jefe) nunca puede fijarlas.
    function listServerKeys() {
      return [
        'itemCount', 'groupedItemsCount', 'viewCount', 'likes', 'followersCount',
        'commentsCount', 'reviewCount', 'averageRating', 'criteriaAverages',
        'criteriaAveragesUpdatedAt', 'reactions', 'lastActivityAt', 'lastReviewAt'
      ];
    }

    // Al crear, los formularios inicializan las métricas vacías (0 / {}).
    function listMetricsAreInitial(data) {
      return data.get('itemCount', 0) == 0
             && data.get('groupedItemsCount', 0) == 0
             && data.get('viewCount', 0) == 0
             && data.get('likes', 0) == 0
             && data.get('followersCount', 0) == 0
             && data.get('commentsCount', 0) == 0
             && data.get('reviewCount', 0) == 0
             && (data.get('averageRating', 0) == 0 || data.get('averageRating', 0) == null)
             && data.get('criteriaAverages', {}) == {}
             && data.get('reactions', {}) == {}
             && !data.keys().hasAny(['lastActivityAt', 'lastReviewAt']);
    }

    // Identidad de la lista: nadie salvo un jefe la cambia después de crearla.
    function listIdentityKeys() {
      return ['userId', 'ownerId', 'authorId', 'parentListId', 'parentId', 'isSublist'];
    }

    // Permisos y visibilidad: solo los decide el dueño (o un jefe), no un editor.
    function listOwnerOnlyKeys() {
      return ['editors', 'guests', 'isPublic', 'visibility', 'publicAccess', 'deletedAt'];
    }

    // Una Minilista contiene SIEMPRE todos los criterios de su Lista madre.
    // (Las propias puede añadirlas; los cambios de la madre los propaga el servidor.)
    function minilistKeepsParentCriteria(data) {
      let parentId = data.get('parentListId', null);
      return parentId == null || parentId == ''
        || !exists(/databases/$(database)/documents/lists/$(parentId))
        || data.get('criteriaDefinition', {}).keys().hasAll(
             get(/databases/$(database)/documents/lists/$(parentId)).data.get('criteriaDefinition', {}).keys());
    }

    // Una Minilista nunca es más pública que su Lista madre: con la madre
    // privada, la Minilista solo puede ser privada (también para jefes). Si la
    // madre pasa a privada, el servidor pone privadas sus Minilistas.
    function minilistNotMorePublicThanParent(data) {
      let parentId = data.get('parentListId', null);
      let wantsPublic = data.get('isPublic', false) == true || data.get('visibility', '') == 'public';
      return parentId == null || parentId == '' || !wantsPublic
        || !exists(/databases/$(database)/documents/lists/$(parentId))
        || get(/databases/$(database)/documents/lists/$(parentId)).data.get('isPublic', false) == true
        || get(/databases/$(database)/documents/lists/$(parentId)).data.get('visibility', '') == 'public';
    }

    // Con valoraciones, la forma de calcular la nota queda bloqueada: se pueden
    // añadir criterios (no cambian notas ya puestas) pero no quitarlos ni
    // cambiar pesos existentes. Eso lo hace una migración del servidor.
    // Listas antiguas sin `scoringWeights`: se acepta la primera escritura de pesos
    // (el formulario los deriva de «cuenta / no cuenta», que ya no se puede cambiar);
    // desde ahí quedan bloqueados. El backfill del servidor los rellena en todas.
    function listScoringLockRespected() {
      let beforeCriteria = resource.data.get('criteriaDefinition', {});
      let afterCriteria = request.resource.data.get('criteriaDefinition', {});
      let beforeWeights = resource.data.get('scoringWeights', {});
      let afterWeights = request.resource.data.get('scoringWeights', {});
      let weightsDiff = afterWeights.diff(beforeWeights);
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.get('reviewCount', 0) == 0 || (
        afterCriteria.keys().hasAll(beforeCriteria.keys())
        && weightsDiff.changedKeys().size() == 0
        && weightsDiff.removedKeys().size() == 0
        && (beforeWeights.size() > 0 || afterWeights.size() > 0 || !changed.hasAny(['criteriaDefinition']))
      );
    }

    function listUpdateIsAllowedFor(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let isOwner = resource.data.userId == uid;
      let isEditor = resource.data.get('editors', []).hasAny([uid]);
      return listUpdateChangesOnlyAllowedFields()
        && (!changed.hasAny(['isPublic', 'visibility', 'parentListId']) || minilistNotMorePublicThanParent(request.resource.data))
        && (
        isJefe(uid) ||
        (
          !changed.hasAny(listServerKeys()) &&
          !changed.hasAny(listIdentityKeys()) &&
          (isOwner || (isEditor && !changed.hasAny(listOwnerOnlyKeys()))) &&
          listScoringLockRespected() &&
          (!changed.hasAny(['criteriaDefinition']) || minilistKeepsParentCriteria(request.resource.data))
        )
      );
    }

    function reviewAllowedCreateKeys() {
      return [
        'listId', 'parentListId', 'sublistId', 'visibility', 'userId',
        'authorId', 'authorName', 'authorUsername', 'authorPhoto',
        'authorPhotoUrl', 'authorUserType', 'itemName', 'itemNameLower',
        'comment', 'overallRating', 'rating', 'scores', 'tags',
        'userTags', 'reactionCounts', 'commentsCount', 'photoUrl',
        'photoUrls', 'photoStoragePaths', 'photos', 'placeId',
        'placeName', 'placeAddress', 'placeLat', 'placeLng',
        'criteriaDefinition', 'createdAt', 'updatedAt'
      ];
    }

    function reviewAllowedUpdateKeys() {
      return [
        'listId', 'parentListId', 'sublistId', 'visibility', 'userId',
        'authorId', 'authorName', 'authorUsername', 'authorPhoto',
        'authorPhotoUrl', 'authorUserType', 'itemName', 'itemNameLower',
        'comment', 'overallRating', 'rating', 'scores', 'tags',
        'userTags', 'reactionCounts', 'commentsCount', 'photoUrl',
        'photoUrls', 'photoStoragePaths', 'photos', 'placeId',
        'placeName', 'placeAddress', 'placeLat', 'placeLng',
        'criteriaDefinition', 'createdAt', 'updatedAt', 'deletedAt',
        'moderationStatus', 'placeClosedStatus'
      ];
    }

    function reviewCreateHasOnlyAllowedFields() {
      return request.resource.data.keys().hasOnly(reviewAllowedCreateKeys());
    }

    function reviewUpdateChangesOnlyAllowedFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(reviewAllowedUpdateKeys());
    }

    function businessClaimAllowedCreateKeys() {
      return [
        'userId', 'userEmail', 'userName', 'placeId', 'placeName', 'placeAddress',
        'role', 'contactEmail', 'contactPhone', 'website', 'message', 'status',
        'proofs', 'truthDeclarationAccepted', 'truthDeclarationText',
        'truthDeclarationAcceptedAt', 'createdAt', 'updatedAt'
      ];
    }

    function businessClaimCreateIsValid(claimId) {
      return request.resource.data.keys().hasOnly(businessClaimAllowedCreateKeys())
             && request.resource.data.userId == request.auth.uid
             && claimId == request.auth.uid + '_' + request.resource.data.placeId
             && request.resource.data.status == 'pending'
             && request.resource.data.placeId is string
             && request.resource.data.placeName is string
             && request.resource.data.role is string
             && request.resource.data.contactEmail is string
             && request.resource.data.message is string
             && request.resource.data.proofs is list
             && request.resource.data.truthDeclarationAccepted == true
             && request.resource.data.truthDeclarationText is string;
    }

    function businessClaimResubmitIsValid(claimId) {
      return resource.data.userId == request.auth.uid
             && resource.data.status == 'rejected'
             && businessClaimCreateIsValid(claimId);
    }

    // Helper: comprobar si el usuario puede leer una lista concreta por ID.
    // Una lista privada solo la ven su dueño, sus editores, sus invitados y
    // los jefes. Seguir a un usuario o a una lista NO da acceso: esos
    // documentos los crea el propio seguidor sin validación, así que no
    // pueden servir como permiso (ver sublistas_funcionamiento.txt §3B).
    function canReadListById(listId) {
      let list = get(/databases/$(database)/documents/lists/$(listId)).data;
      return list != null && (
        list.isPublic == true ||
        list.visibility == 'public' ||
        (
          isUser() &&
          (
            list.userId == request.auth.uid ||
            isJefe(request.auth.uid) ||
            (list.editors is list && list.editors.hasAny([request.auth.uid])) ||
            (list.guests is list && list.guests.hasAny([request.auth.uid]))
          )
        )
      );
    }

    // Las reseñas públicas se pueden descubrir sin cuenta. Las privadas solo
    // son visibles para su autor o para quien tenga acceso a la lista/sublista
    // privada que las contiene.
    function canReadReviewByListId(listId) {
      let reviewVisibility = resource.data.get('visibility', 'private');
      let sublistId = resource.data.get('sublistId', '');
      let hasSublist = sublistId is string && sublistId != '';
      return listId is string && (
        (reviewVisibility == 'public' && canReadListById(listId)) ||
        (
          isUser() &&
          (
            resource.data.userId == request.auth.uid ||
            resource.data.get('authorId', '') == request.auth.uid ||
            isJefe(request.auth.uid) ||
            (hasSublist && canReadListById(sublistId)) ||
            (!hasSublist && canReadListById(listId))
          )
        )
      );
    }

    // `visibility` se desnormaliza en la reseña para poder autorizar feeds de
    // collectionGroup. Por eso no puede quedar a elección del cliente: debe
    // reflejar siempre la lista o sublista real donde se creó.
    function reviewVisibilityMatchesList(reviewData, listId) {
      let sublistId = reviewData.get('sublistId', '');
      let targetListId = sublistId is string && sublistId != '' ? sublistId : listId;
      let targetList = get(/databases/$(database)/documents/lists/$(targetListId)).data;
      let targetIsPublic = targetList != null && (
        targetList.isPublic == true || targetList.visibility == 'public'
      );
      return targetList != null && (
        (targetIsPublic && reviewData.get('visibility', '') == 'public') ||
        (!targetIsPublic && reviewData.get('visibility', '') == 'private')
      );
    }

    function reviewIdentityAndTargetDidNotChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'visibility', 'listId', 'parentListId', 'sublistId',
        'userId', 'authorId', 'createdAt'
      ]);
    }

    // La visibilidad solo puede sincronizarla quien administra la lista real
    // de la reseña, y únicamente con el valor que esa lista tiene ahora.
    function canManageReviewTarget(reviewData, listId) {
      let sublistId = reviewData.get('sublistId', '');
      let targetListId = sublistId is string && sublistId != '' ? sublistId : listId;
      let targetList = get(/databases/$(database)/documents/lists/$(targetListId)).data;
      return isUser() && targetList != null && (
        targetList.userId == request.auth.uid ||
        (targetList.editors is list && targetList.editors.hasAny([request.auth.uid])) ||
        isJefe(request.auth.uid)
      );
    }

    function reviewVisibilityUpdateIsValid(listId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(['visibility'])
             && changedKeys.hasAny(['visibility'])
             && request.resource.data.listId == listId
             && reviewVisibilityMatchesList(request.resource.data, listId)
             && canManageReviewTarget(request.resource.data, listId);
    }

    function isListOwner(listId) {
      return isUser() && get(/databases/$(database)/documents/lists/$(listId)).data.userId == request.auth.uid;
    }

    function isNonNegativeWholeNumber(value) {
      return value is int && value >= 0;
    }

    function hasReactionCounts(data) {
      return data.reactionCounts is map &&
             data.reactionCounts.keys().hasOnly(['like', 'dislike']) &&
             isNonNegativeWholeNumber(data.reactionCounts.like) &&
             isNonNegativeWholeNumber(data.reactionCounts.dislike);
    }

    // Los contadores que puede tocar cualquier lector solo cambian de uno en
    // uno (un me gusta / un comentario). `request.writeFields` está obsoleto,
    // así que se compara el documento antes y después.
    function changesByAtMostOne(before, after) {
      return after - before <= 1 && before - after <= 1;
    }

    function isReactionCountUpdate() {
      let before = resource.data.get('reactionCounts', {});
      let after = request.resource.data.reactionCounts;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCounts']) &&
             hasReactionCounts(request.resource.data) &&
             changesByAtMostOne(before.get('like', 0), after.like) &&
             changesByAtMostOne(before.get('dislike', 0), after.dislike);
    }

    function isCommentsCountUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']) &&
             isNonNegativeWholeNumber(request.resource.data.commentsCount) &&
             changesByAtMostOne(resource.data.get('commentsCount', 0), request.resource.data.commentsCount);
    }

    function reactionHasOnlyAllowedFields() {
      return request.resource.data.keys().hasOnly(['reaction', 'userId', 'createdAt', 'updatedAt']) &&
             request.resource.data.reaction == 'like';
    }

    function commentCreateHasOnlyAllowedFields() {
      return request.resource.data.keys().hasOnly(['userId', 'userName', 'userPhoto', 'text', 'createdAt']);
    }

    function commentUpdateChangesOnlyAllowedFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']);
    }

    // ===============================================
    // REGLA PARA COLLECTION GROUP 'reviews'
    // ===============================================
    // Las reseñas públicas son contenido navegable sin cuenta. Todas las queries
    // de collectionGroup llevan un límite para acotar coste y abuso.

    match /{path=**}/reviews/{reviewId} {
      allow get: if resource.data.listId is string && canReadReviewByListId(resource.data.listId);
      // Sin valores por defecto (ver la regla `list` de lists/{listId}/reviews):
      // con canReadReviewByListId, `where('listId', '==', <Lista pública>)` devolvía
      // también las privadas de sus Minilistas privadas.
      allow list: if request.query.limit != null
                  && request.query.limit <= 100
                  && (
                    resource.data.visibility == 'public' ||
                    (
                      isUser() && (
                        resource.data.userId == request.auth.uid ||
                        resource.data.authorId == request.auth.uid ||
                        isJefe(request.auth.uid) ||
                        (resource.data.sublistId is string && canReadListById(resource.data.sublistId)) ||
                        (resource.data.listId is string &&
                          get(/databases/$(database)/documents/lists/$(resource.data.listId)).data.visibility != 'public' &&
                          canReadListById(resource.data.listId))
                      )
                    )
                  );
    }

    // Consulta de grupo para las fotos de lugar subidas por el usuario.
    // Las fotos se siguen leyendo públicamente desde places/{placeId}/photos,
    // pero las vistas de perfil/archivo solo pueden listar las propias por userId.
    match /{path=**}/photos/{photoId} {
      allow read: if isUser() && resource.data.userId == request.auth.uid;
    }

    // ===============================================
    // REGLAS PARA USUARIOS (`users`) (ACTUALIZADAS)
    // ===============================================
    match /users/{userId} {
      allow get: if isUser() && (request.auth.uid == userId || isJefe(request.auth.uid));
      allow list: if isUser() && isJefe(request.auth.uid);
      // Un usuario puede crear/editarse a sí mismo.
      allow create: if isUser() &&
                    request.auth.uid == userId &&
                    doesNotSetUserType() &&
                    userCreateHasOnlyAllowedFields() &&
                    userCreateLegalAcceptanceOk();
      allow update: if isUser() && (
        (
          request.auth.uid == userId && doesNotChangeUserType()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userSelfUpdateKeys())
          && userUpdateLegalAcceptanceOk()
          && userUpdateUxPreferencesOk()
        ) || (isJefe(request.auth.uid) && userUpdateChangesOnlyAllowedFields())
      );
      // Un usuario puede borrarse a sí mismo O un jefe puede borrarlo.
      allow delete: if isUser() && (request.auth.uid == userId || isJefe(request.auth.uid)); // <-- CAMBIO: Añadido permiso de borrado para jefe.

      match /following/{followId} {
        allow read: if isUser();
        allow create, delete: if isUser() && request.auth.uid == userId;
      }

      match /followingPlaces/{placeId} {
        allow read: if isUser() && request.auth.uid == userId;
        allow write: if isUser() && request.auth.uid == userId;
      }

      // Permitir al propio usuario leer sus listas seguidas
      match /followingLists/{listId} {
        allow read: if isUser();
        allow create, delete: if isUser() && request.auth.uid == userId;
      }

      match /followers/{followerId} {
        allow read, list: if isUser();
        allow write: if false;
      }

      match /archives/{archiveId} {
        allow read, list: if isUser() && request.auth.uid == userId;
        allow create, update, delete: if isUser() && request.auth.uid == userId;

        match /items/{entityKey} {
          allow read, list: if isUser() && request.auth.uid == userId;
          allow create, update, delete: if isUser() && request.auth.uid == userId;
        }
      }

      match /archiveIndex/{entityKey} {
        allow read, list: if isUser() && request.auth.uid == userId;
        allow create, update, delete: if isUser() && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read, list, update: if isUser() && request.auth.uid == userId;
        allow create: if isUser() && request.auth.uid == userId;
        allow delete: if isUser() && request.auth.uid == userId;
      }

      match /fcmTokens/{token} {
        allow read, write: if isUser() && request.auth.uid == userId;
      }

      // Regla para las medallas obtenidas
      // «Apto para»: respuestas privadas de quien aporta (sin gluten, movilidad…).
      // Solo las ve su autor; el servidor las cuenta de forma anónima en el sitio.
      match /aptReports/{reviewId} {
        allow read: if isUser() && request.auth.uid == userId;
        allow delete: if isUser() && request.auth.uid == userId;
        allow create, update: if isUser() && request.auth.uid == userId &&
                              aptReportIsValid(request.resource.data, userId, reviewId);
      }

      match /obtainedBadges/{badgeId} {
        allow read: if true;
        allow write: if isUser() && isJefe(request.auth.uid);
      }
    }

    // Espejo publico de perfil. Lo escribe Cloud Functions desde users/{uid}
    // para poder migrar el frontend sin exponer datos privados del documento users.
    match /publicProfiles/{userId} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 50;
      allow write: if false;
    }

    // Reserva de usernames (docId = username en minúsculas)
    match /usernameClaims/{usernameKey} {
      allow get: if isUser();
      allow list: if false;
      allow create: if isUser()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.usernameLower == usernameKey
                    && !exists(/databases/$(database)/documents/usernameClaims/$(usernameKey));
      allow update: if isUser()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.usernameLower == resource.data.usernameLower
                    && request.resource.data.usernameLower == usernameKey;
      allow delete: if false;
    }

    // Helper: comprobar si el usuario puede escribir en una lista
    function canWriteToList(listId) {
      let list = get(/databases/$(database)/documents/lists/$(listId)).data;
      return list != null && (
        list.userId == request.auth.uid ||
        (list.editors is list && list.editors.hasAny([request.auth.uid])) ||
        (list.isPublic == true && list.publicAccess == 'writer')
      );
    }

    // Helper: permite escribir en una lista padre si el usuario tiene acceso de escritura
    // en una de sus sublistas (identificada por sublistId en el documento a crear)
    function canWriteToSublistOf(parentListId) {
      let sid = request.resource.data.sublistId;
      return sid is string &&
             exists(/databases/$(database)/documents/lists/$(sid)) &&
             get(/databases/$(database)/documents/lists/$(sid)).data.parentListId == parentListId &&
             (
               get(/databases/$(database)/documents/lists/$(sid)).data.userId == request.auth.uid ||
               (
                 get(/databases/$(database)/documents/lists/$(sid)).data.editors is list &&
                 get(/databases/$(database)/documents/lists/$(sid)).data.editors.hasAny([request.auth.uid])
               )
             );
    }

    // ===============================================
    // REGLAS PARA LISTAS (`lists`) (ACTUALIZADAS)
    // ===============================================
    match /lists/{listId} {
      allow read: if resource.data.isPublic == true ||
                      resource.data.visibility == 'public' ||
                      (isUser() && (
                        resource.data.userId == request.auth.uid ||
                        (resource.data.get('editors', []).hasAny([request.auth.uid])) ||
                        (resource.data.get('guests', []).hasAny([request.auth.uid])) ||
                        isJefe(request.auth.uid)
                      ));
      allow list: if resource.data.isPublic == true || resource.data.visibility == 'public' || (isUser() && (
        resource.data.userId == request.auth.uid || 
        (resource.data.get('editors', []).hasAny([request.auth.uid])) ||
        isJefe(request.auth.uid)
      ));
      
      allow create: if isUser()
                    && request.resource.data.userId == request.auth.uid
                    && listCreateHasOnlyAllowedFields()
                    && minilistNotMorePublicThanParent(request.resource.data)
                    && (isJefe(request.auth.uid) || (
                         listMetricsAreInitial(request.resource.data)
                         && minilistKeepsParentCriteria(request.resource.data)));
      // El dueño de la lista O un jefe pueden borrarla.
      allow delete: if isUser() && (resource.data.userId == request.auth.uid || isJefe(request.auth.uid));

      // Update: dueño o editor (sin métricas, identidad ni permisos) o jefe.
      allow update: if isUser() && listUpdateIsAllowedFor(request.auth.uid);

      match /reviews/{reviewId} {
        allow get: if canReadReviewByListId(listId);
        // En consultas, las reglas evalúan `resource.data.get(campo, defecto)` con el
        // valor por defecto: con canReadReviewByListId, una consulta sin filtrar por
        // visibilidad en una Lista pública devolvía las privadas de sus Minilistas
        // privadas a cualquiera con sesión. Aquí nada usa valores por defecto: hay que
        // pedir `visibility == 'public'`, las propias, la Minilista (`sublistId`) o
        // ser miembro de una lista privada.
        allow list: if (resource.data.visibility == 'public' && canReadListById(listId)) ||
          (isUser() && (
            resource.data.userId == request.auth.uid ||
            isJefe(request.auth.uid) ||
            (resource.data.sublistId is string && canReadListById(resource.data.sublistId)) ||
            (get(/databases/$(database)/documents/lists/$(listId)).data.get('visibility', 'private') != 'public' &&
              canReadListById(listId))
          ));
        // CREATE: Validar que tenga permiso de ESCRITURA en la lista,
        // o que tenga acceso de escritura en una sublista de esta lista
        allow create: if isUser()
                         && request.resource.data.userId == request.auth.uid
                         && request.resource.data.listId == listId
                         && reviewCreateHasOnlyAllowedFields()
                         && reviewVisibilityMatchesList(request.resource.data, listId)
                         && (canWriteToList(listId) || canWriteToSublistOf(listId));
        
        // UPDATE/DELETE: El autor o un jefe puede hacerlo.
        allow update: if isUser()
                      && reviewUpdateChangesOnlyAllowedFields()
                      && request.resource.data.listId == listId
                      && (
                        (
                          (
                            resource.data.userId == request.auth.uid ||
                            isJefe(request.auth.uid) ||
                            (canReadListById(listId) && (isReactionCountUpdate() || isCommentsCountUpdate()))
                          )
                          && reviewIdentityAndTargetDidNotChange()
                        ) ||
                        reviewVisibilityUpdateIsValid(listId)
                      );
        allow delete: if isUser() && (
          resource.data.userId == request.auth.uid ||
          resource.data.authorId == request.auth.uid ||
          isJefe(request.auth.uid)
        );

        match /reactions/{reactionUserId} {
          allow read: if canReadListById(listId);
          allow create, update: if isUser()
                                 && request.auth.uid == reactionUserId
                                 && request.resource.data.userId == request.auth.uid
                                 && reactionHasOnlyAllowedFields()
                                 && canReadListById(listId);
          allow delete: if isUser()
                         && request.auth.uid == reactionUserId
                         && canReadListById(listId);
        }

        match /comments/{commentId} {
          allow read: if canReadListById(listId);
          allow create: if isUser()
                          && canReadListById(listId)
                          && request.resource.data.userId == request.auth.uid
                          && commentCreateHasOnlyAllowedFields();
          allow update: if isUser()
                         && canReadListById(listId)
                         && (
                              resource.data.userId == request.auth.uid
                              || isListOwner(listId)
                              || isJefe(request.auth.uid)
                            )
                         && commentUpdateChangesOnlyAllowedFields();
          allow delete: if isUser()
                         && canReadListById(listId)
                         && (
                              resource.data.userId == request.auth.uid
                              || isListOwner(listId)
                              || isJefe(request.auth.uid)
                            );
        }
      }
    }

    // Reseñas legacy en colección raíz. La app ya escribe en
    // lists/{listId}/reviews, pero estas reglas evitan que queries
    // collectionGroup('reviews') fallen por documentos antiguos.
    match /reviews/{reviewId} {
      allow read: if resource.data.listId is string && canReadReviewByListId(resource.data.listId);
      allow create: if isUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.listId is string
                    && reviewCreateHasOnlyAllowedFields()
                    && reviewVisibilityMatchesList(request.resource.data, request.resource.data.listId)
                    && canWriteToList(request.resource.data.listId);
      allow update: if isUser()
                    && request.resource.data.listId is string
                    && reviewUpdateChangesOnlyAllowedFields()
                    && (
                      (
                        (
                          resource.data.userId == request.auth.uid ||
                          resource.data.authorId == request.auth.uid ||
                          isJefe(request.auth.uid)
                        )
                        && reviewIdentityAndTargetDidNotChange()
                      ) ||
                      reviewVisibilityUpdateIsValid(request.resource.data.listId)
                    );
      allow delete: if isUser() && (
        resource.data.userId == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        isJefe(request.auth.uid)
      );
    }

    // ===============================================
    // REGLAS PARA ME GUSTA DE LISTAS (`list_likes`)
    // ===============================================
    match /list_likes/{likeId} {
      allow read: if isUser();
      allow create: if isUser() && request.resource.data.userId == request.auth.uid;
      allow delete: if isUser() && resource.data.userId == request.auth.uid;
    }

    // ===============================================
    // REGLAS PARA LUGARES, MEDALLAS Y CATEGORÍAS (MANTENIDAS)
    // ===============================================
    // Campos que un cliente puede usar al crear un lugar de respaldo (cuando
    // la sincronización con Google falla). Todo lo demás (negocio, Stripe,
    // métricas, datos de Google) lo escriben Cloud Functions.
    function placeClientCreateKeys() {
      return [
        'name', 'name_normalized', 'address', 'address_normalized', 'location',
        'coordinates', 'googlePlaceId', 'types', 'createdAt', 'updatedAt',
        'followersCount', 'reviewsCount', 'averageRating'
      ];
    }

    function isOwnStorageImageUrl(url) {
      return url is string
             && url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/listopic[.](firebasestorage[.]app|appspot[.]com)/o/.*');
    }

    match /places/{placeId} {
        allow read: if true;
        allow list: if isUser();
        allow create: if isUser() && (
            isJefe(request.auth.uid) ||
            (
              request.resource.data.keys().hasOnly(placeClientCreateKeys())
              && request.resource.data.get('reviewsCount', 0) == 0
              && request.resource.data.get('followersCount', 0) == 0
              && request.resource.data.get('averageRating', null) == null
              && request.resource.data.get('googlePlaceId', placeId) == placeId
            )
        );
        // Un cliente solo puede poner la portada de un lugar que aún no la
        // tiene, y solo con una imagen de nuestro Storage. Métricas y datos
        // de Google los actualizan Cloud Functions (o un jefe).
        allow update: if isUser() && (
            isJefe(request.auth.uid) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userPhotoUrl', 'lastUserPhotoAt'])
              && resource.data.get('userPhotoUrl', '') in ['', null]
              && isOwnStorageImageUrl(request.resource.data.userPhotoUrl)
            )
        );
        allow delete: if isUser() && isJefe(request.auth.uid);

        // Subcolección de seguidores de un lugar
        match /followers/{userId} {
          allow read: if isUser();
          allow create, delete: if isUser() && request.auth.uid == userId;
        }

        // Fotos aportadas por usuarios al lugar.
        match /photos/{photoId} {
          allow read: if true;
          allow create: if isUser()
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.url is string
                        && request.resource.data.storagePath is string
                        && request.resource.data.placeId == placeId
                        && request.resource.data.keys().hasOnly([
                          'url', 'caption', 'storagePath', 'placeId', 'placeName',
                          'userId', 'userName', 'userPhoto', 'source', 'createdAt'
                        ]);
          allow update, delete: if isUser() && (
            resource.data.userId == request.auth.uid || isJefe(request.auth.uid)
          );
        }

        // Datos de negocio gestionados mediante Cloud Functions.
        // El cliente solo lee la proyeccion publica ya resuelta, sin tier/status/owner.
        match /resolvedPublic/{docId} {
          allow read: if docId == 'business';
          allow write: if false;
        }

        match /businessInfo/{sectionId} {
          allow read, write: if false;
        }

        match /businessInfoHistory/{changeId} {
          allow read, write: if false;
        }

        match /businessInfoMeta/{sectionId} {
          allow read, write: if false;
        }

        // Personalización visual Business Pro. La escribe Cloud Functions
        // (updateBusinessVisual) tras validar gestor + plan Pro activo.
        match /businessPro/{docId} {
          allow read: if true;
          allow write: if false;
        }

        // Ofertas Business Pro. Las escribe Cloud Functions
        // (saveBusinessOffer/deleteBusinessOffer) tras validar gestor + plan Pro.
        match /offers/{offerId} {
          allow read: if true;
          allow write: if false;
        }

        // Items canónicos persistentes del lugar. Los genera Cloud Functions
        // desde las reseñas; el cliente puede leerlos para carta/estadísticas.
        match /items/{itemId} {
          allow read: if true;
          allow write: if false;

          match /listStats/{listId} {
            allow read: if true;
            allow write: if false;
          }
        }
    }
    
    // Propuestas de carta Business Pro (fusiones, renombres, reasignación de
    // reseñas). Las crea y resuelve Cloud Functions; el negocio lee las suyas
    // (query con createdBy == uid) y el jefe todas.
    match /itemProposals/{proposalId} {
      allow read: if isUser() && (
        isJefe(request.auth.uid) || resource.data.createdBy == request.auth.uid
      );
      allow write: if false;
    }

    // Emplazamientos patrocinados (home/búsqueda). Las campañas activas son
    // públicas; borradores/rechazos solo los ven creador y jefe.
    match /sponsoredPlacements/{placementId} {
      allow read: if resource.data.status == 'active' || (
        isUser() && (
          resource.data.createdBy == request.auth.uid || isJefe(request.auth.uid)
        )
      );
      allow write: if false;
    }

    // Platos destacados por radio. Las campañas activas son públicas para el
    // carrusel; el resto solo lo ven creador y jefe.
    match /sponsoredItemSpotlights/{spotlightId} {
      allow read: if resource.data.status == 'active' || (
        isUser() && (
          resource.data.createdBy == request.auth.uid || isJefe(request.auth.uid)
        )
      );
      allow write: if false;
    }

    // Duelo de la semana: dos platos rivales votados por la comunidad.
    // Los crea/finaliza el jefe desde Developer; cada usuario un voto (doc con
    // su uid), que puede cambiar mientras el duelo siga activo.
    match /duels/{duelId} {
      allow read: if true;
      allow write: if isUser() && isJefe(request.auth.uid);

      match /votes/{userId} {
        allow read: if true;
        allow create, update: if isUser()
          && request.auth.uid == userId
          && request.resource.data.side in ['a', 'b']
          && get(/databases/$(database)/documents/duels/$(duelId)).data.status == 'active';
        allow delete: if false;
      }
    }

    match /badges/{badgeId} {
      allow read: if true;
      allow list, write: if isUser() && isJefe(request.auth.uid);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow list, write: if isUser() && isJefe(request.auth.uid);
    }
        // REGLAS PARA LA PAPELERA (`deleted_items`) (¡NUEVA!)
    // ==================================================================
    match /deleted_items/{deletedId} {
        // Solo un jefe puede crear documentos aquí (es decir, "borrar" algo).
        allow create: if isUser() && isJefe(request.auth.uid);
        
        // Un jefe también puede leerlos para una futura UI de "papelera".
        allow read, list: if isUser() && isJefe(request.auth.uid);
        
        // Nadie puede actualizar o borrar desde el cliente para mantener la integridad del archivo.
        allow update, delete: if false;
    }

    // ==================================================================
    // REGLAS PARA REPORTES (`reports`) (NUEVA)
    // ==================================================================
    match /reports/{reportId} {
        // Cualquier usuario autenticado puede reportar, pero el reporte
        // tiene que ir firmado por él mismo (no se puede suplantar).
        allow create: if false;
        allow read, list, update, delete: if isUser() && isJefe(request.auth.uid);
    }

    // ==================================================================
    // REGLAS PARA FOROS (`listForums`) (MANTENIDAS)
    // ==================================================================
    match /listForums/{listId} {
      allow list: if isUser() && isJefe(request.auth.uid);
      
      function canAccessList() {
          let list = get(/databases/$(database)/documents/lists/$(listId)).data;
          return list.isPublic == true || (isUser() && (list.userId == request.auth.uid || isJefe(request.auth.uid)));
      }

      allow read: if canAccessList();

      match /messages/{messageId} {
        allow read, list: if canAccessList();
        // Crear mensajes requiere además que el remitente sea el propio usuario
        // autenticado (evita suplantaciones dentro del foro).
        allow create: if isUser()
                       && canAccessList()
                       && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isUser() && (resource.data.userId == request.auth.uid || isJefe(request.auth.uid));
      }
    }

    // Vista previa pública del enlace de invitación a un grupo. Solo se lee
    // sabiendo el código; la crean o cambian los del grupo con el código vigente.
    match /chatInvites/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isUser()
                             && request.resource.data.keys().hasOnly(['chatId', 'groupName', 'byName', 'approval', 'createdAt'])
                             && request.resource.data.get('approval', false) is bool
                             && request.resource.data.chatId is string
                             && request.resource.data.groupName is string && request.resource.data.groupName.size() <= 60
                             && request.resource.data.byName is string && request.resource.data.byName.size() <= 80
                             && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants
                             && getAfter(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.get('joinCode', '') == code;
      allow delete: if isUser()
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants;
    }

    match /chats/{chatId} {
      allow list, get: if isUser()
                  && request.auth.uid in resource.data.participants;
      allow create: if isUser()
                     && request.auth.uid in request.resource.data.participants;
      // Se puede añadir gente (un chat privado pasa a grupo), pero nadie puede
      // expulsar a otros participantes ni reescribir la lista.
      allow update: if isUser()
                     && request.auth.uid in resource.data.participants
                     && request.auth.uid in request.resource.data.participants
                     && request.resource.data.participants.hasAll(resource.data.participants)
                     && request.resource.data.participants.size() <= 50;
      // Enlace de invitación (/g/{código}): quien no está entra él solo en un
      // grupo con el código vigente, sin tocar nada más.
      allow update: if isUser()
                     && !(request.auth.uid in resource.data.participants)
                     && resource.data.type == 'group'
                     && resource.data.get('joinApproval', false) != true
                     && resource.data.get('joinCode', '') is string
                     && resource.data.get('joinCode', '').size() >= 8
                     && request.resource.data.get('joinedWith', '') == resource.data.joinCode
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'joinedWith', 'updatedAt'])
                     && request.resource.data.participants == resource.data.participants.concat([request.auth.uid])
                     && request.resource.data.participants.size() <= 50;
      allow delete: if false;

      // Grupo con aprobación: quien abre el enlace deja su solicitud y la
      // acepta o rechaza cualquiera del grupo.
      match /joinRequests/{uid} {
        function isChatMember() {
          return isUser()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
        allow get: if (isUser() && request.auth.uid == uid) || isChatMember();
        allow list: if isChatMember();
        allow create: if isUser()
                       && request.auth.uid == uid
                       && !isChatMember()
                       && get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group'
                       && get(/databases/$(database)/documents/chats/$(chatId)).data.get('joinApproval', false) == true
                       && request.resource.data.keys().hasOnly(['name', 'code', 'at'])
                       && request.resource.data.name is string && request.resource.data.name.size() <= 80
                       && request.resource.data.code is string && request.resource.data.code.size() >= 8
                       && request.resource.data.code == get(/databases/$(database)/documents/chats/$(chatId)).data.get('joinCode', '');
        allow update: if false;
        allow delete: if (isUser() && request.auth.uid == uid) || isChatMember();
      }

      match /messages/{messageId} {
        allow list, get: if isUser()
                     && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isUser()
                       && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                       && request.resource.data.senderId == request.auth.uid;
        // Un mensaje no se reescribe. Solo cambia lo «vivo»: la reacción propia,
        // la respuesta propia a una invitación, el voto propio en una encuesta y,
        // si invitas tú, la fecha de tu invitación o cancelarla.
        allow update: if isUser()
                       && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'invite', 'poll', 'datePoll'])
                       && chatReactionUpdateOk()
                       && chatInviteUpdateOk()
                       && chatPollUpdateOk()
                       && chatDatePollUpdateOk();
        allow delete: if false;

        function onlyOwnKeyChanged(after, before) {
          return after is map && after.diff(before).affectedKeys().hasOnly([request.auth.uid]);
        }

        function chatReactionUpdateOk() {
          let after = request.resource.data.get('reactions', {});
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactions'])
            || (onlyOwnKeyChanged(after, resource.data.get('reactions', {}))
                && (!(request.auth.uid in after) || (after[request.auth.uid] is string && after[request.auth.uid].size() <= 16)));
        }

        function chatInviteUpdateOk() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['invite'])
            || (resource.data.invite is map && request.resource.data.invite is map && (
                  (resource.data.senderId == request.auth.uid
                    && request.resource.data.invite.diff(resource.data.invite).affectedKeys().hasOnly(['when', 'responses', 'cancelled'])
                    && request.resource.data.invite.when is number
                    && request.resource.data.invite.responses is map
                    && request.resource.data.invite.get('cancelled', false) is bool)
                  || (request.resource.data.invite.diff(resource.data.invite).affectedKeys().hasOnly(['responses'])
                    && onlyOwnKeyChanged(request.resource.data.invite.get('responses', {}), resource.data.invite.get('responses', {}))
                    && (!(request.auth.uid in request.resource.data.invite.get('responses', {}))
                        || request.resource.data.invite.responses[request.auth.uid].status in ['yes', 'maybe', 'other', 'no']))
                ));
        }

        function chatPollUpdateOk() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['poll'])
            || (resource.data.poll is map && request.resource.data.poll is map
                && request.resource.data.poll.diff(resource.data.poll).affectedKeys().hasOnly(['votes'])
                && onlyOwnKeyChanged(request.resource.data.poll.get('votes', {}), resource.data.poll.get('votes', {}))
                && (!(request.auth.uid in request.resource.data.poll.get('votes', {}))
                    || request.resource.data.poll.votes[request.auth.uid] is string));
        }

        // «¿Cuándo quedamos?»: cada uno marca sus fechas; y cualquiera del grupo
        // la cierra una sola vez apuntando a la quedada que sale de ella.
        function chatDatePollUpdateOk() {
          let before = resource.data.get('datePoll', {});
          let after = request.resource.data.get('datePoll', {});
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['datePoll'])
            || (resource.data.datePoll is map && after is map
                && ((after.diff(before).affectedKeys().hasOnly(['votes'])
                     && onlyOwnKeyChanged(after.get('votes', {}), before.get('votes', {}))
                     && (!(request.auth.uid in after.get('votes', {}))
                         || (after.votes[request.auth.uid] is map && after.votes[request.auth.uid].size() <= 6)))
                    || (after.diff(before).affectedKeys().hasOnly(['inviteId'])
                        && !('inviteId' in before)
                        && after.inviteId is string)));
        }
      }
    }

    // ==================================================================
    // REGLAS PARA CONFIG
    // ==================================================================
    // CAMBIO DE SEGURIDAD: `config/serverSecrets` NO puede leerse desde el
    // cliente (antes: `allow read: if true` exponía la Google API Key).
    // El resto de documentos en `config/` siguen siendo públicos (branding,
    // feature flags, etc.) pero solo modificables por `jefe`.
    // TODO(seguridad): migrar los secretos a Google Secret Manager.
    // config/serverSecrets: solo jefe (secretos del servidor).
    // La regla genérica de config/* excluye explícitamente este documento
    // para que el wildcard no lo exponga aunque "allow read: if true" lo cubra.
    // Compras de impulsos con Stripe: las escriben createImpulsePackCheckoutSession
    // y el webhook; solo las leen los jefes.
    match /impulsePurchases/{purchaseId} {
      allow read: if isUser() && isJefe(request.auth.uid);
      allow write: if false;
    }

    // Beta de planes («Lo quiero»): solo la escribe registerPlanInterest.
    match /planInterest/{interestId} {
      allow read: if isUser() && isJefe(request.auth.uid);
      allow write: if false;
    }

    match /config/serverSecrets {
      allow read, write: if isUser() && isJefe(request.auth.uid);
    }

    // El resto de config (branding, featureFlags, appConfig…): lectura pública, escritura jefe.
    match /config/{configId} {
      allow read: if configId != 'serverSecrets';
      allow write: if isUser() && isJefe(request.auth.uid);
    }

    // ==================================================================
    // AUDIT LOG DE ACCIONES DE ADMIN
    // ==================================================================
    // Escritura: solo Cloud Functions (admin SDK bypassa las reglas).
    // Lectura: solo jefes. Nadie puede editar ni borrar desde el cliente.
    match /adminAuditLog/{entryId} {
      allow read, list: if isUser() && isJefe(request.auth.uid);
      allow write: if false;
    }

    // API Usage Logs y Estadísticas (solo lectura jefe, escritura solo Cloud Functions)
    match /apiUsageLogs/{entryId} {
      allow read, list: if isUser() && isJefe(request.auth.uid);
      allow write: if false;
    }
    match /apiUsageStats/{docId} {
      allow read, list: if isUser() && isJefe(request.auth.uid);
      allow write: if false;
    }

    // Analítica de navegación: el cliente nunca accede directamente. Las
    // vistas se agregan y consultan mediante Cloud Functions, que aplican
    // rate-limit y autorización de jefe sin exponer marcadores de sesión.
    match /pageAnalyticsTotals/{docId} {
      allow read, write: if false;
    }
    match /pageAnalyticsDaily/{docId} {
      allow read, write: if false;
    }
    match /pageAnalyticsGlobal/{docId} {
      allow read, write: if false;
    }
    match /pageAnalyticsGlobalDaily/{docId} {
      allow read, write: if false;
    }
    match /pageAnalyticsSessionMarkers/{docId} {
      allow read, write: if false;
    }
    match /placeAnalyticsDaily/{docId} {
      allow read, write: if false;
    }
    match /connectionGeoDaily/{docId} {
      allow read, write: if false;
    }
    match /connectionGeoMarkers/{docId} {
      allow read, write: if false;
    }
    match /reviewGeoDaily/{docId} {
      allow read, write: if false;
    }
    match /reviewAnalyticsMarkers/{docId} {
      allow read, write: if false;
    }
    match /shareEventMarkers/{docId} {
      allow read, write: if false;
    }
    match /sponsoredEventMarkers/{docId} {
      allow read, write: if false;
    }

    // ==================================================================
    // RECLAMACIONES DE NEGOCIO (roadmap cuentas de negocio)
    // ==================================================================
    match /businessClaims/{claimId} {
      allow read: if isUser() && (
        resource.data.userId == request.auth.uid || isJefe(request.auth.uid)
      );
      allow create: if isUser() && businessClaimCreateIsValid(claimId);
      allow update: if isUser() && (
        isJefe(request.auth.uid) || businessClaimResubmitIsValid(claimId)
      );
      allow delete: if false;
    }

    // ==================================================================
    // PACHOTE (cuentas de grupo, pachote-78042.web.app). Aquí también entra
    // gente sin cuenta (usuario anónimo), así que estas reglas no usan isUser().
    // Ve y toca un grupo quien entró con su link vigente o lo creó. Si el grupo
    // está enlazado a un chat de Listopic (chatId), los de ese chat ven la ficha
    // (con su resumen de saldos) y pueden entrar sin link.
    // ==================================================================
    function pSignedIn() { return request.auth != null; }
    function pGrp(gid) { return get(/databases/$(database)/documents/pachoteGroups/$(gid)); }
    function pAccPath(gid) { return /databases/$(database)/documents/pachoteGroups/$(gid)/access/$(request.auth.uid); }
    function pIsMember(gid) { return pSignedIn() && exists(pAccPath(gid)); }
    function pRole(gid) { return get(pAccPath(gid)).data.role; }
    function pCanEdit(gid) { return pIsMember(gid) && pRole(gid) in ['admin', 'editor']; }
    // Administra quien tiene el rol de administrador o, si el grupo lo permite («todos administran»), cualquiera que pueda apuntar.
    function pIsAdmin(gid) { return pIsMember(gid) && (pRole(gid) == 'admin' || (pRole(gid) == 'editor' && pGrp(gid).data.get('allAdmin', false) == true)); }
    function pInChat(chatId) {
      return isUser() && chatId is string && chatId.size() > 0
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }
    // Enlazar con un chat solo puede hacerlo alguien que esté en ese chat.
    function pChatLinkOk(after, before) {
      return !after.diff(before).affectedKeys().hasAny(['chatId'])
        || after.get('chatId', '') == '' || pInChat(after.get('chatId', ''));
    }

    // Mis grupos y mi perfil de Pachote: solo yo.
    match /pachoteUsers/{uid} {
      allow read, write: if pSignedIn() && request.auth.uid == uid;
    }

    match /pachoteGroups/{gid} {
      allow get: if pIsMember(gid) || pInChat(resource.data.get('chatId', ''));
      allow list: if false;
      allow create: if pSignedIn() && request.resource.data.owner == request.auth.uid
                    && request.resource.data.inviteToken is string && request.resource.data.inviteToken.size() >= 16
                    && pChatLinkOk(request.resource.data, {});
      // Los editores cambian gente, familias, opciones y el resumen; el dueño, el link y el chat enlazado solo un administrador.
      allow update: if pCanEdit(gid) && pChatLinkOk(request.resource.data, resource.data) && (pIsAdmin(gid) ||
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner', 'inviteToken', 'allAdmin', 'chatId']));
      allow delete: if pIsAdmin(gid);

      // Un documento por movimiento.
      match /movs/{mid} {
        allow read: if pIsMember(gid);
        allow write: if pCanEdit(gid);
      }

      // Historial de cambios: cualquiera que pueda apuntar añade entradas a su nombre; nadie las edita.
      match /log/{lid} {
        allow read: if pIsMember(gid);
        allow create: if pCanEdit(gid) && request.resource.data.uid == request.auth.uid && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if pIsAdmin(gid);
      }

      // Dispositivos con acceso.
      match /access/{uid} {
        allow read: if pIsMember(gid);
        // Entrar: con el link vigente o desde el chat enlazado (como editor) o, si es el dueño recién creado, como administrador.
        allow create: if pSignedIn() && uid == request.auth.uid && (
            (request.resource.data.role == 'editor' && request.resource.data.get('token', '') == pGrp(gid).data.inviteToken)
         || (request.resource.data.role == 'editor' && pInChat(pGrp(gid).data.get('chatId', '')))
         || (request.resource.data.role == 'admin' && pGrp(gid).data.owner == request.auth.uid));
        // Cada uno cambia su «quién soy»; los permisos solo un administrador.
        allow update: if pIsAdmin(gid) || (uid == request.auth.uid &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'token']));
        allow delete: if uid == request.auth.uid || pIsAdmin(gid);
      }
    }
  }
}
