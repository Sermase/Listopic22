rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Función de ayuda para roles (UNIFICADA) ---
    function isJefe(userId) {
      let userDoc = get(/databases/$(database)/documents/users/$(userId)).data;
      let userType = userDoc != null ? userDoc.userType : null;
      return (userType is list && userType.hasAny(['jefe']))
             || (userType is string && userType == 'jefe');
    }

    function isFollowingUser(targetUserId) {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(targetUserId)).data != null;
    }

    function isFollowingList(listId) {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)/followingLists/$(listId)).data != null;
    }

    function isListFollower(listId) {
      return request.auth != null &&
             get(/databases/$(database)/documents/lists/$(listId)/followers/$(request.auth.uid)).data != null;
    }

    // Helper: comprobar si el usuario puede leer una lista concreta por ID
    function canReadListById(listId) {
      let list = get(/databases/$(database)/documents/lists/$(listId)).data;
      return list != null && (
        list.isPublic == true ||
        (
          request.auth != null &&
          (
            list.userId == request.auth.uid ||
            isJefe(request.auth.uid) ||
            isFollowingUser(list.userId) ||
            isFollowingList(listId) ||
            isListFollower(listId) ||
            (list.editors is list && list.editors.hasAny([request.auth.uid])) ||
            (list.guests is list && list.guests.hasAny([request.auth.uid]))
          )
        )
      );
    }

    function isListOwner(listId) {
      return request.auth != null && get(/databases/$(database)/documents/lists/$(listId)).data.userId == request.auth.uid;
    }

    function isNonNegativeWholeNumber(value) {
      return (value is int && value >= 0) ||
             (value is float && value >= 0 && value == floor(value));
    }

    function hasReactionCounts(data) {
      return data.reactionCounts is map &&
             data.reactionCounts.keys().hasOnly(['like', 'dislike']) &&
             isNonNegativeWholeNumber(data.reactionCounts.like) &&
             isNonNegativeWholeNumber(data.reactionCounts.dislike);
    }

    function isReactionCountUpdate() {
      return request.writeFields.hasOnly(['reactionCounts', 'reactionCounts.like', 'reactionCounts.dislike']) &&
             hasReactionCounts(request.resource.data);
    }

    function isCommentsCountUpdate() {
      return request.writeFields.hasOnly(['commentsCount']) &&
             isNonNegativeWholeNumber(request.resource.data.commentsCount);
    }

    // ===============================================
    // REGLA PARA COLLECTION GROUP 'reviews'
    // ===============================================
    // Cualquier usuario autenticado puede leer reseñas (colección raíz y subcollections).
    // Las reseñas son contenido social público; la privacidad se gestiona en el nivel de la lista.

    match /{path=**}/reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.listId is string
                    && (canWriteToList(request.resource.data.listId) || canWriteToSublistOf(request.resource.data.listId));
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        isJefe(request.auth.uid)
      );
    }

    // ===============================================
    // REGLAS PARA USUARIOS (`users`) (ACTUALIZADAS)
    // ===============================================
    match /users/{userId} {
      allow read: if true;
      // Allow authenticated users to query by username/usernameLower for collaborator lookup
      allow list: if request.auth != null;
      // Un usuario puede crear/editarse a sí mismo.
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        (
          request.auth.uid == userId && request.resource.data.userType == resource.data.userType
        ) || isJefe(request.auth.uid)
      );
      // Un usuario puede borrarse a sí mismo O un jefe puede borrarlo.
      allow delete: if request.auth != null && (request.auth.uid == userId || isJefe(request.auth.uid)); // <-- CAMBIO: Añadido permiso de borrado para jefe.

      match /following/{followId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /followingPlaces/{placeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Permitir al propio usuario leer sus listas seguidas
      match /followingLists/{listId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /followers/{followerId} {
        allow read, list: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /archives/{archiveId} {
        allow read, list: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;

        match /items/{entityKey} {
          allow read, list: if request.auth != null && request.auth.uid == userId;
          allow create, update, delete: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /archiveIndex/{entityKey} {
        allow read, list: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read, list, update: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Regla para las medallas obtenidas
      match /obtainedBadges/{badgeId} {
        allow read: if true;
        allow write: if request.auth != null && isJefe(request.auth.uid);
      }
    }

    // Reserva de usernames (docId = username en minúsculas)
    match /usernameClaims/{usernameKey} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.usernameLower == usernameKey
                    && !exists(/databases/$(database)/documents/usernameClaims/$(usernameKey));
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.usernameLower == resource.data.usernameLower
                    && request.resource.data.usernameLower == usernameKey;
      allow delete: if false;
    }

    // Helper: comprobar si el usuario puede escribir en una lista
    function canWriteToList(listId) {
      let list = get(/databases/$(database)/documents/lists/$(listId)).data;
      return list != null && (
        list.userId == request.auth.uid ||
        (list.editors is list && list.editors.hasAny([request.auth.uid])) ||
        (list.isPublic == true && list.publicAccess == 'writer')
      );
    }

    // Helper: permite escribir en una lista padre si el usuario tiene acceso de escritura
    // en una de sus sublistas (identificada por sublistId en el documento a crear)
    function canWriteToSublistOf(parentListId) {
      let sid = request.resource.data.sublistId;
      let sublist = (sid is string)
        ? get(/databases/$(database)/documents/lists/$(sid)).data
        : null;
      return sublist != null &&
             sublist.parentListId == parentListId &&
             (
               sublist.userId == request.auth.uid ||
               (sublist.editors is list && sublist.editors.hasAny([request.auth.uid]))
             );
    }

    // ===============================================
    // REGLAS PARA LISTAS (`lists`) (ACTUALIZADAS)
    // ===============================================
    match /lists/{listId} {
      allow read: if resource.data.isPublic == true ||
                      (request.auth != null && (
                        resource.data.userId == request.auth.uid ||
                        (resource.data.get('editors', []).hasAny([request.auth.uid])) ||
                        (resource.data.get('guests', []).hasAny([request.auth.uid])) ||
                        isJefe(request.auth.uid) ||
                        isFollowingUser(resource.data.userId) ||
                        isFollowingList(listId) ||
                        isListFollower(listId)
                      ));
      allow list: if resource.data.isPublic == true || (request.auth != null && (
        resource.data.userId == request.auth.uid || 
        (resource.data.get('editors', []).hasAny([request.auth.uid])) ||
        isJefe(request.auth.uid)
      ));
      
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // El dueño de la lista O un jefe pueden borrarla.
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isJefe(request.auth.uid));
      
      // Update: solo dueño, editor o jefe.
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        (resource.data.get('editors', []).hasAny([request.auth.uid])) ||
        isJefe(request.auth.uid)
      );

      match /reviews/{reviewId} {
        allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || canReadListById(listId);
        // CREATE: Validar que tenga permiso de ESCRITURA en la lista,
        // o que tenga acceso de escritura en una sublista de esta lista
        allow create: if request.auth != null
                         && request.resource.data.userId == request.auth.uid
                         && (canWriteToList(listId) || canWriteToSublistOf(listId));
        
        // UPDATE/DELETE: El autor o un jefe puede hacerlo.
        allow update: if request.auth != null && (
                        resource.data.userId == request.auth.uid ||
                        isJefe(request.auth.uid) ||
                        (canReadListById(listId) && (isReactionCountUpdate() || isCommentsCountUpdate()))
                      );
        allow delete: if request.auth != null && (
          resource.data.userId == request.auth.uid ||
          resource.data.authorId == request.auth.uid ||
          isJefe(request.auth.uid)
        );

        match /reactions/{reactionUserId} {
          allow read: if canReadListById(listId);
          allow create, update: if request.auth != null
                                 && request.auth.uid == reactionUserId
                                 && request.resource.data.userId == request.auth.uid
                                 && canReadListById(listId);
          allow delete: if request.auth != null
                         && request.auth.uid == reactionUserId
                         && canReadListById(listId);
        }

        match /comments/{commentId} {
          allow read: if canReadListById(listId);
          allow create: if request.auth != null
                          && canReadListById(listId)
                          && request.resource.data.userId == request.auth.uid;
          allow update, delete: if request.auth != null
                                 && canReadListById(listId)
                                 && (
                                      resource.data.userId == request.auth.uid
                                      || isListOwner(listId)
                                      || isJefe(request.auth.uid)
                                    );
        }
      }
    }

    // ===============================================
    // REGLAS PARA ME GUSTA DE LISTAS (`list_likes`)
    // ===============================================
    match /list_likes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ===============================================
    // REGLAS PARA LUGARES, MEDALLAS Y CATEGORÍAS (MANTENIDAS)
    // ===============================================
    match /places/{placeId} {
        allow read: if true;
        allow list: if request.auth != null;
        allow create: if request.auth != null;
        // Permitir update si es Jefe O si solo está actualizando contadores/métricas específicas
        allow update: if request.auth != null && (
            isJefe(request.auth.uid) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewsCount', 'averageRating', 'lastGoogleSync', 'lastPhotoRefresh'])
        );
        allow delete: if request.auth != null && isJefe(request.auth.uid);

        // Subcolección de seguidores de un lugar
        match /followers/{userId} {
          allow read: if request.auth != null;
          allow create, delete: if request.auth != null && request.auth.uid == userId;
        }
    }
    
    match /badges/{badgeId} {
      allow read: if true;
      allow list, write: if request.auth != null && isJefe(request.auth.uid);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow list, write: if request.auth != null && isJefe(request.auth.uid);
    }
        // REGLAS PARA LA PAPELERA (`deleted_items`) (¡NUEVA!)
    // ==================================================================
    match /deleted_items/{deletedId} {
        // Solo un jefe puede crear documentos aquí (es decir, "borrar" algo).
        allow create: if request.auth != null && isJefe(request.auth.uid);
        
        // Un jefe también puede leerlos para una futura UI de "papelera".
        allow read, list: if request.auth != null && isJefe(request.auth.uid);
        
        // Nadie puede actualizar o borrar desde el cliente para mantener la integridad del archivo.
        allow update, delete: if false;
    }

    // ==================================================================
    // REGLAS PARA REPORTES (`reports`) (NUEVA)
    // ==================================================================
    match /reports/{reportId} {
        // Cualquier usuario autenticado puede reportar, pero el reporte
        // tiene que ir firmado por él mismo (no se puede suplantar).
        allow create: if request.auth != null
                       && request.resource.data.userId == request.auth.uid;
        allow read, list, update, delete: if request.auth != null && isJefe(request.auth.uid);
    }

    // ==================================================================
    // REGLAS PARA FOROS (`listForums`) (MANTENIDAS)
    // ==================================================================
    match /listForums/{listId} {
      allow list: if request.auth != null && isJefe(request.auth.uid);
      
      function canAccessList() {
          let list = get(/databases/$(database)/documents/lists/$(listId)).data;
          return list.isPublic == true || (request.auth != null && (list.userId == request.auth.uid || isJefe(request.auth.uid)));
      }

      allow read: if canAccessList();

      match /messages/{messageId} {
        allow read, list: if canAccessList();
        // Crear mensajes requiere además que el remitente sea el propio usuario
        // autenticado (evita suplantaciones dentro del foro).
        allow create: if request.auth != null
                       && canAccessList()
                       && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isJefe(request.auth.uid));
      }
    }

    match /chats/{chatId} {
      allow list, get: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                     && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
                     && request.auth.uid in resource.data.participants
                     && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow list, get: if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
                       && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                       && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ==================================================================
    // REGLAS PARA CONFIG
    // ==================================================================
    // CAMBIO DE SEGURIDAD: `config/serverSecrets` NO puede leerse desde el
    // cliente (antes: `allow read: if true` exponía la Google API Key).
    // El resto de documentos en `config/` siguen siendo públicos (branding,
    // feature flags, etc.) pero solo modificables por `jefe`.
    // TODO(seguridad): migrar los secretos a Google Secret Manager.
    // config/serverSecrets: solo jefe (secretos del servidor).
    // La regla genérica de config/* excluye explícitamente este documento
    // para que el wildcard no lo exponga aunque "allow read: if true" lo cubra.
    match /config/serverSecrets {
      allow read, write: if request.auth != null && isJefe(request.auth.uid);
    }

    // El resto de config (branding, featureFlags, appConfig…): lectura pública, escritura jefe.
    match /config/{configId} {
      allow read: if configId != 'serverSecrets';
      allow write: if request.auth != null && isJefe(request.auth.uid);
    }

    // ==================================================================
    // AUDIT LOG DE ACCIONES DE ADMIN
    // ==================================================================
    // Escritura: solo Cloud Functions (admin SDK bypassa las reglas).
    // Lectura: solo jefes. Nadie puede editar ni borrar desde el cliente.
    match /adminAuditLog/{entryId} {
      allow read, list: if request.auth != null && isJefe(request.auth.uid);
      allow write: if false;
    }

    // ==================================================================
    // RECLAMACIONES DE NEGOCIO (roadmap cuentas de negocio)
    // ==================================================================
    match /businessClaims/{claimId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || isJefe(request.auth.uid)
      );
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if request.auth != null && isJefe(request.auth.uid);
      allow delete: if false;
    }
  }
}



