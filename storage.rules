rules_version = '2';

// Estas reglas son para el servicio de Firebase Storage
service firebase.storage {

  // Apuntamos al contenedor principal de nuestro Storage
  match /b/{bucket}/o {

    // REGLA PARA LAS IMÁGENES DE LAS RESEÑAS (LA IMPORTANTE)
    match /reviews/{userId}/{reviewId}/{imageName} {
      allow read; 
      // Permite la escritura SOLO si el usuario está logueado Y su ID de usuario
      // coincide con el {userId} en la ruta del archivo.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Regla para las fotos de perfil de usuario (Legacy/Correct path used in frontend)
    match /profile_images/{userId}/{allPaths=**} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Regla para las fotos de perfil de usuario (Old path, keeping just in case)
    match /user-profiles/{userId}/{imageName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Regla para las imágenes de las listas
    match /list-images/{listId}/{imageName} {
      allow read;
      allow write: if request.auth != null;
    }
  }
}