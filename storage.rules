rules_version = '2';

// Estas reglas son para el servicio de Firebase Storage
service firebase.storage {

  // Apuntamos al contenedor principal de nuestro Storage
  match /b/{bucket}/o {

    // REGLA PARA LAS IMÁGENES DE LAS RESEÑAS (LA IMPORTANTE)
    // REGLA PARA LAS IMÁGENES DE LAS RESEÑAS
    // Permite cualquier estructura dentro de reviews/{userId}/...
    match /reviews/{userId}/{allPaths=**} {
      allow read; 
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Regla para las fotos de perfil de usuario (Legacy/Correct path used in frontend)
    match /profile_images/{userId}/{allPaths=**} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Regla para las fotos de perfil de usuario (Old path, keeping just in case)
    match /user-profiles/{userId}/{imageName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Regla para las imágenes de las listas
    match /list-images/{listId}/{imageName} {
      allow read;
      allow write: if request.auth != null;
    }

    // Regla para las medallas (Badges)
    match /badges/{badgeId}/{imageName} {
      allow read;
      allow write: if request.auth != null; // Restrict to admin in production if possible, but auth is better than nothing
    }
  }
}