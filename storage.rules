rules_version = '2';

// Reglas de Firebase Storage.
//
// NOTA: estas reglas dependen de Firestore para comprobar ownership / rol `jefe`.
// Cada comprobación hace una lectura de Firestore (se factura, pero es trazable y centralizado).
// Migración futura recomendada: mover `jefe` a Custom Claim (request.auth.token.admin)
// para evitar la lectura de Firestore en cada escritura de Storage.

service firebase.storage {
  match /b/{bucket}/o {

    // --- Helpers ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isJefe() {
      // Primera opción: custom claim (barato, sin extra read).
      // Segunda opción: fallback a Firestore.
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          (
            firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.userType == 'jefe' ||
            (
              firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.userType is list &&
              firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.userType.hasAny(['jefe'])
            )
          )
        )
      );
    }

    function isListOwner(listId) {
      return isSignedIn() &&
             firestore.exists(/databases/(default)/documents/lists/$(listId)) &&
             firestore.get(/databases/(default)/documents/lists/$(listId)).data.userId == request.auth.uid;
    }

    // Aceptamos solo imágenes razonables: <= 10 MB y content-type image/*.
    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*');
    }

    // --- Reseñas: el dueño del uid del path puede escribir, todos pueden leer. ---
    match /reviews/{userId}/{allPaths=**} {
      allow read;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
    }

    // --- Fotos de perfil (ruta usada por el frontend). ---
    match /profile_images/{userId}/{allPaths=**} {
      allow read;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
    }

    // --- Ruta heredada (se mantiene por si hay URLs antiguas). ---
    match /user-profiles/{userId}/{imageName} {
      allow read;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
    }

    // --- Imágenes de listas: solo propietario de la lista o jefe. ---
    // Antes: cualquier autenticado podía sobreescribir cualquier imagen (IDOR).
    match /list-images/{listId}/{imageName} {
      allow read;
      allow write: if isValidImage() && (isListOwner(listId) || isJefe());
    }

    // --- Branding (logo/favicon del sitio): solo jefe. ---
    match /branding/{allPaths=**} {
      allow read;
      allow write: if isJefe() && isValidImage();
    }

    // --- Medallas: solo jefe. ---
    match /badges/{badgeId}/{imageName} {
      allow read;
      allow write: if isJefe() && isValidImage();
    }

    // --- Documentos de reclamación de negocio (roadmap): dueño del claim o jefe. ---
    // Estructura: business-claims/{userId}/{claimId}/docs/{fileName}
    match /business-claims/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isJefe());
      allow write: if isSignedIn() && request.auth.uid == userId &&
                      request.resource.size < 25 * 1024 * 1024;
    }

    // --- Por defecto, denegar todo lo que no matchee arriba. ---
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
